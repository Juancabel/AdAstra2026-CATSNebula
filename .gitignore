# Archivos originales

/corpus_original

# Salida de la ingesta. 200 MB: por encima del limite de 100 MB por archivo de
# GitHub. Es dato derivado y la corrida es determinista (mismo sha256 en dos
# ejecuciones), asi que se regenera en ~2,5 min con:
#     python src/ingest_data.py corpus_original data/documents.jsonl
#     python detectar_idioma.py data/documents.jsonl data/documents.jsonl
/data/documents.jsonl
/data/chunks.jsonl
/data/fallos_ingesta_data.jsonl
/data/reporte_idioma.json
# Paginas crudas cacheadas por scripts/ab_extraccion.py. Dato derivado del
# corpus, solo para que el A/B de un fix no vuelva a abrir los PDF cada vez.
/data/cache_paginas_muestra.json
# Indice vectorial. index.faiss son ~336 MB (86.046 x 1024 x 4 B) y
# metadata.jsonl ~240 MB: los dos por encima del limite de 100 MB por archivo
# de GitHub. Se regeneran con:
#     python encode_index.py data/chunks.jsonl entrega/base_vectorial/encoder_bge-m3
# El manifiesto SI se versiona: es la trazabilidad de que corrida produjo la
# entrega (revision del modelo, versiones, sha256 de los dos artefactos).
/entrega/base_vectorial/*/index.faiss
/entrega/base_vectorial/*/metadata.jsonl
/entrega/base_vectorial/*/.parcial/

# Ambientes virtuales.

/.venv
/venv

# Pycache
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd

# Logging.

data/*.log